<?xml version="1.0" encoding="utf-8"?>

<data-extraction-rules>
    <!-- Encrypted with a key in Android Keystore which can't be backed up anyway. -->
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="encrypted_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="encrypted_settings.xml" />
    </device-transfer>
</data-extraction-rules>
